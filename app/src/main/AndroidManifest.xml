<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <!-- Needed to enumerate and launch other installed apps -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission"
        xmlns:tools="http://schemas.android.com/tools" />

    <!-- Needed for Govee light control -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Quick settings: show the Wi-Fi network -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- Open the launcher when the TV finishes starting up -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Optional backup: lets Android open the launcher from the background -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Backup auto-open method (for TVs whose accessibility settings don't work) -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions"
        xmlns:tools="http://schemas.android.com/tools" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Optional, granted once over ADB: lets the app switch its own accessibility service on -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions"
        xmlns:tools="http://schemas.android.com/tools" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Cinema mode: Do Not Disturb -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <!-- Ambient music visualiser (optional; asked for in Settings) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <application
        android:name=".LauncherApp"
        android:usesCleartextTraffic="true"
        android:allowBackup="true"
        android:banner="@drawable/app_banner"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.MinimalLauncher">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:launchMode="singleTask"
            android:theme="@style/Theme.MinimalLauncher">

            <!-- Standard app launch entry -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- This is what makes it installable/selectable as the TV Home app -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <!-- Leanback launcher category some TV OS versions check for -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>

        </activity>

        <activity
            android:name=".AllAppsActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:parentActivityName=".MainActivity"
            android:theme="@style/Theme.MinimalLauncher" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:parentActivityName=".MainActivity"
            android:theme="@style/Theme.MinimalLauncher" />

        <activity
            android:name=".ClaudeActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:parentActivityName=".MainActivity"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.MinimalLauncher" />

        <!-- "Watch": films and shows across all apps; also listed as its own app -->
        <activity
            android:name=".WatchActivity"
            android:exported="true"
            android:label="Watch"
            android:banner="@drawable/app_banner"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.MinimalLauncher">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".AmbientActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:launchMode="singleTop"
            android:theme="@style/Theme.MinimalLauncher" />

        <!-- Aerial as the system screensaver -->
        <service
            android:name=".AerialDream"
            android:exported="true"
            android:label="Minimal Launcher Aerial"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

        <!-- "Now playing": Android shares media sessions with notification listeners only -->
        <service
            android:name=".MediaListener"
            android:exported="false"
            android:label="Minimal Launcher now playing"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- iPhone remote web server -->
        <service
            android:name=".RemoteService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Local web server for the companion phone remote" />
        </service>

        <receiver
            android:name=".RecordReceiver"
            android:exported="false" />

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- Backup: watches for the stock home screen using usage access. -->
        <service
            android:name=".AppWatchService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Opens this home-screen app when the stock TV home screen appears" />
        </service>

        <!-- Opens this launcher whenever the stock Google TV home appears. -->
        <service
            android:name=".HomeRedirectService"
            android:exported="true"
            android:label="@string/home_redirect_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/home_redirect_service" />
        </service>
    </application>
</manifest>
