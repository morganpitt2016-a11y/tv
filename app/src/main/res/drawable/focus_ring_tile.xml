<?xml version="1.0" encoding="utf-8"?>
<!-- White ring drawn over a dock tile / card while it has D-pad focus. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle"><corners android:radius="12dp" /><stroke android:width="2dp" android:color="#E6FFFFFF" /></shape>
    </item>
    <item android:drawable="@android:color/transparent" />
</selector>
