<?xml version="1.0" encoding="utf-8"?>
<!-- Glass edge drawn over dock tiles and cards: a faint hairline and top
     sheen at rest; a brighter sheen and soft white edge when focused
     (tvOS style, instead of a thick outline). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="12dp" />
                    <gradient android:angle="270" android:startColor="#38FFFFFF" android:centerColor="#08FFFFFF" android:endColor="#00FFFFFF" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="12dp" />
                    <stroke android:width="1dp" android:color="#8CFFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="12dp" />
                    <gradient android:angle="270" android:startColor="#14FFFFFF" android:centerColor="#00FFFFFF" android:endColor="#00FFFFFF" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="12dp" />
                    <stroke android:width="0.5dp" android:color="#26FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
