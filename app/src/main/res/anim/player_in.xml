<?xml version="1.0" encoding="utf-8"?>
<!-- Opening the player: it zooms up into place like an app opening. -->
<set xmlns:android="http://schemas.android.com/apk/res/android" android:interpolator="@android:interpolator/decelerate_quint">
    <alpha android:fromAlpha="0" android:toAlpha="1" android:duration="300" />
    <scale android:fromXScale="0.88" android:toXScale="1" android:fromYScale="0.88" android:toYScale="1"
        android:pivotX="50%" android:pivotY="50%" android:duration="380" />
</set>
