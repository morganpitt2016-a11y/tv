<?xml version="1.0" encoding="utf-8"?>
<!-- A screen arrives over the last one: quick fade up, settling from very slightly smaller (tvOS). -->
<set xmlns:android="http://schemas.android.com/apk/res/android" android:interpolator="@android:interpolator/decelerate_quint">
    <alpha android:fromAlpha="0" android:toAlpha="1" android:duration="220" />
    <scale android:fromXScale="0.975" android:toXScale="1" android:fromYScale="0.975" android:toYScale="1"
        android:pivotX="50%" android:pivotY="50%" android:duration="260" />
</set>
