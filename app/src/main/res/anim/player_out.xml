<?xml version="1.0" encoding="utf-8"?>
<!-- Leaving the player: it shrinks away, like closing an app. -->
<set xmlns:android="http://schemas.android.com/apk/res/android" android:interpolator="@android:interpolator/accelerate_cubic" android:zAdjustment="top">
    <alpha android:fromAlpha="1" android:toAlpha="0" android:duration="280" />
    <scale android:fromXScale="1" android:toXScale="0.88" android:fromYScale="1" android:toYScale="0.88"
        android:pivotX="50%" android:pivotY="50%" android:duration="300" />
</set>
